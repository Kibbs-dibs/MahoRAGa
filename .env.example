# ═══════════════════════════════════════════════════════════════════════════
# Project Aletheia — Environment Configuration Template (.env.example)
# ═══════════════════════════════════════════════════════════════════════════

# ── 1. LLM Backend Configuration ──────────────────────────────────────────
# Default: Local Ollama daemon
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Anthropic / NVIDIA Proxy (Optional)
ANTHROPIC_BASE_URL=http://localhost:8082
ANTHROPIC_AUTH_TOKEN=freecc
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=nvidia_nim/nvidia/nemotron-3-super-120b-a12b

# OpenAI API (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── 2. Three-Layer Global Memory ──────────────────────────────────────────
# Layer 1: Neo4j Knowledge Graph (Hierarchical Indexing)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Layer 2: FAISS Dense Vector Store (IndexFlatIP, 384-dim)
FAISS_INDEX_PATH=data/faiss_index.bin
FAISS_METADATA_PATH=data/faiss_metadata.json

# Layer 3: BM25 Sparse Lexical Store (rank_bm25 + Cross-Encoder)
BM25_INDEX_PATH=data/bm25_index.pkl
BM25_METADATA_PATH=data/bm25_metadata.json

# Embedding & Cross-Encoder Models
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIM=384
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── 3. Pipeline Parameters ────────────────────────────────────────────────
TOP_K_RETRIEVAL=10
EVIDENCE_THRESHOLD=80.0
MAX_COMPRESSION_RATIO=6.3

# ── 4. External Academic APIs (Optional Keys for Higher Rate Limits) ───────
SEMANTIC_SCHOLAR_API_KEY=

# ── 5. Gradio Web Interface ───────────────────────────────────────────────
WEB_UI_HOST=0.0.0.0
WEB_UI_PORT=7860
